# Finance Hub Environment Configuration
# Copy this file to `.env` if you want to customize local runtime settings.
# All values below are optional; by default Finance Hub keeps all data inside ./data.

# Local HTTP server port (bound exclusively to 127.0.0.1)
APP_PORT=8050

# Base currency for newly initialized databases (3-letter ISO 4217 code, 2-decimal currencies).
# Supported examples: GBP, USD, EUR, CAD, AUD, CHF, INR.
# IMPORTANT: Set this BEFORE first startup. Once a database is initialized, changing
# BASE_CURRENCY to a conflicting code intentionally blocks startup so monetary totals
# are never silently re-labeled.
BASE_CURRENCY=GBP

# IANA timezone for newly initialized databases (used for calendar-day cutoffs and balance anchors).
# Examples: Europe/London, America/New_York, Europe/Berlin, Asia/Kolkata, Australia/Sydney.
# IMPORTANT: Only applied when initializing a database that has no stored `app_timezone` yet;
# existing initialized databases keep their stored timezone so past day boundaries are never silently shifted.
APP_TIMEZONE=Europe/London

# Optional custom directory for the default profile's ZIP backup archives.
# Leave unset to store backups inside ./data/backups.
# BACKUP_DIR=/path/to/your/backups
